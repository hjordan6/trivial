DATABASE_URL=postgres://trivial:trivial@localhost:5432/trivial?sslmode=disable
HTTP_ADDRESS=:8080
COOKIE_SECURE=false
DEVELOPMENT_MODE=true
TEST_DATABASE_URL=postgres://trivial:trivial@localhost:5433/trivial_test?sslmode=disable
PUZZLE_TIMEZONE=America/Denver
# Production runs this at 180 (the code default). Dev runs it short so
# local generation recovers faster once the small starter library runs
# dry -- see README.md ("Starter library limits") for why it runs dry
# regardless of this value.
QUESTION_COOLDOWN_DAYS=7
# No two questions with the same answer may land within this many days of
# each other, whatever their prompts, topics, or difficulties. Production
# runs this at 14 (the code default); dev runs it short for the same reason
# the question cooldown does.
ANSWER_COOLDOWN_DAYS=7
TIME_LIMIT_SECONDS=240
# Gates the admin panel at /admin and every /api/admin route. Leave it unset
# and the whole surface answers 404 -- there is no other way to disable it, and
# no default, because a default admin password is worse than none.
ADMIN_PASSWORD=letmein
# Keys every signed cookie the application issues. Required, with no default,
# because a shared default signing key is the same as no signing at all.
# Generate one with `openssl rand -base64 48`. Changing it signs everyone out
# and invalidates every player cookie, so treat it as permanent.
APP_SECRET=dev-secret-not-for-production-0123456789
# Enables real sign-in email. Leave it unset and the code goes to the server
# log instead (development) or sign-in reports itself unavailable (production).
# Deliberately not "unset means broken": a sign-in form that silently swallows
# codes is worse than one that says it is off.
RESEND_API_KEY=
# Required whenever RESEND_API_KEY is set. The domain must be verified in
# Resend, or every send is refused.
MAIL_FROM=
# How long a six-digit sign-in code stays valid.
LOGIN_CODE_TTL_MINUTES=15
# Makes the per-IP rate limiter read the last hop of X-Forwarded-For instead of
# RemoteAddr. Required behind a reverse proxy, and unsafe without one: the
# header is caller-supplied, so trusting it lets anyone mint a fresh bucket per
# request.
TRUST_PROXY_IP=false
