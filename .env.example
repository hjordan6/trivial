DATABASE_URL=postgres://trivial:trivial@localhost:5432/trivial?sslmode=disable
HTTP_ADDRESS=:8080
COOKIE_SECURE=false
DEVELOPMENT_MODE=true
TEST_DATABASE_URL=postgres://trivial:trivial@localhost:5433/trivial_test?sslmode=disable
PUZZLE_TIMEZONE=America/Denver
# Production runs this at 180 (the code default). Dev runs it short so
# local generation recovers faster once the small starter library runs
# dry -- see README.md ("Starter library limits") for why it runs dry
# regardless of this value.
QUESTION_COOLDOWN_DAYS=7
TIME_LIMIT_SECONDS=135
# Gates the admin panel at /admin and every /api/admin route. Leave it unset
# and the whole surface answers 404 -- there is no other way to disable it, and
# no default, because a default admin password is worse than none.
ADMIN_PASSWORD=letmein

# Which client addresses may reach the admin panel at all, checked before the
# password. Comma-separated IPs and/or CIDR blocks; a bare IP means that one
# host. Unset means loopback only -- the machine running the server. Setting it
# replaces that default rather than adding to it.
#
# The check uses the connection's own address and ignores X-Forwarded-For and
# friends, which a caller can set freely. Behind a reverse proxy every request
# therefore looks like it came from the proxy.
ADMIN_ALLOWED_IPS=127.0.0.1,::1

# Identify admin callers by their Tailscale account, using the local tailscaled
# daemon. This is what makes "only my devices" true: being inside Tailscale's
# 100.64.0.0/10 range proves nothing, because every tailnet draws from it.
ADMIN_TAILNET_ACCESS=true

# Which Tailscale logins may reach the admin panel. Leave empty and any peer
# the daemon recognises passes, which includes nodes other people have shared
# into your tailnet -- name yourself to mean "my account only". Setting this
# without ADMIN_TAILNET_ACCESS is a startup error rather than a silent no-op.
ADMIN_TAILNET_USERS=you@example.com

# Where tailscaled listens. The default suits a standard Linux install.
# ADMIN_TAILSCALE_SOCKET=/var/run/tailscale/tailscaled.sock

# HTTP_ADDRESS takes several comma-separated addresses, one listener each.
# Loopback plus the host's own Tailscale address is the usual pair: the panel
# stays reachable on the machine itself, Tailscale devices reach it by the
# tailnet address, and the port is never opened to the wider network.
# HTTP_ADDRESS=127.0.0.1:8092,100.x.y.z:8092
