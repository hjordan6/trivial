DATABASE_URL=postgres://trivial:trivial@localhost:5432/trivial?sslmode=disable
HTTP_ADDRESS=:8080
COOKIE_SECURE=false
DEVELOPMENT_MODE=true
TEST_DATABASE_URL=postgres://trivial:trivial@localhost:5433/trivial_test?sslmode=disable
PUZZLE_TIMEZONE=America/Denver
# Production runs this at 180 (the code default). Dev runs it short so
# local generation recovers faster once the small starter library runs
# dry -- see README.md ("Starter library limits") for why it runs dry
# regardless of this value.
QUESTION_COOLDOWN_DAYS=7
TIME_LIMIT_SECONDS=135
# Gates the admin panel at /admin and every /api/admin route. Leave it unset
# and the whole surface answers 404 -- there is no other way to disable it, and
# no default, because a default admin password is worse than none.
ADMIN_PASSWORD=letmein
